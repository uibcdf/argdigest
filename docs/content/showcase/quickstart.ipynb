   "source": [
    "# Quickstart — ArgDigest in action\n",
    "\n",
    "This notebook shows a minimal example of how to use `@arg_digest`.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "acae54e37e7d407bbb7b55eff062a284",
   "metadata": {},
   "outputs": [],
   "source": [
    "from argdigest import arg_digest\n",
    "\n",
    "\n",
    "@arg_digest(map={\"x\": {\"kind\": \"vector\", \"rules\": [\"ensure_list\"]}})\n",
    "def process(x):\n",
    "    return x"
   ]
  }
